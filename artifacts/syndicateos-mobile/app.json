{
  "expo": {
    "name": "SyndicateOS",
    "slug": "syndicateos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "syndicateos-mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f6f4ec",
      "image": "./assets/brand/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/brand/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
