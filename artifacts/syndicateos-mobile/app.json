{
  "expo": {
    "name": "SyndicateOS",
    "slug": "syndicateos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "syndicateos-mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f6f4ec",
      "image": "./assets/brand/logo-stacked.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#F59E0B"
      }
    },
    "web": {
      "favicon": "./assets/brand/mark.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo-stacked.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#f6f4ec"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
