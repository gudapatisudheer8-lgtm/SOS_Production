modules = ["nodejs-24", "java-graalvm22.3"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.development]
SOS_DB_HOST = "krishisetu-db.cpmomccww28x.ap-south-1.rds.amazonaws.com"
SOS_DB_NAME = "SOS"
SOS_DB_PORT = "5432"
SOS_DB_SSL_MODE = "verify-full"

[nix]
channel = "stable-25_05"
packages = ["jdk21_headless"]
